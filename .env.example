PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=pet_user
DB_PASSWORD=change_me
DB_NAME=pet_friends
# Set to true only for cloud MySQL providers that require/support TLS.
# Leave false for local MySQL — do not enable locally.
DB_SSL=false
# Base64-encoded CA certificate for cloud MySQL providers (e.g. Aiven) whose
# server certificate chains to a private CA. Only used when DB_SSL=true.
# Leave unset for local MySQL. Never commit the real certificate — this is a
# placeholder only.
DB_SSL_CA_BASE64=change_me_for_cloud_mysql

# Comma-separated list of allowed frontend origins. If unset in development,
# the server falls back to safe local defaults (127.0.0.1:5500, localhost:5500).
# In production this must be set explicitly to the real frontend URL(s).
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# Photo upload storage. "local" (disk via multer, default) keeps photos on
# this machine under UPLOAD_DIR. "cloudinary" uploads them to Cloudinary and
# stores the returned secure URL instead. Keep this "local" for day-to-day
# development — only switch to "cloudinary" when you want a cloud/demo photo
# store and have real Cloudinary credentials below.
UPLOAD_PROVIDER=local

# Local upload
UPLOAD_DIR=server/uploads/listings

# Cloudinary upload (only needed when UPLOAD_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me
CLOUDINARY_FOLDER=pet-friends/listings
# Alternative to the three vars above: a single CLOUDINARY_URL
# (cloudinary://<api_key>:<api_secret>@<cloud_name>) is also supported and
# takes priority over CLOUDINARY_CLOUD_NAME/API_KEY/API_SECRET when set.
# CLOUDINARY_URL=cloudinary://change_me:change_me@change_me
